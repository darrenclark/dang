module AocLib/Grid

import Std/Enum

struct {
  rows,
  width,
  height
}

/// Parses from string containing a typical AoC grid of characters
let parse = fn(input) {
  let rows =
    input
    |> split("\n")
    |> filter(fn (l) { len(l) > 0 })
    |> map(to_list)

  let height = len(rows)
  let width = len(rows[0])

  for row in rows {
    assert(len(row) == width)
  }

  Grid{rows: rows, width: width, height: height}
}

/// Creates a new grid filled with `element`
let new = fn(element, width, height) {
  let rows =
    range(0, height)
    |> map(fn (_) {
      range(0, width)
      |> map(fn (_) { element })
    })

  Grid{rows: rows, width: width, height: height}
}

/// Dumps a Grid to console for debugging.
/// Returns input (so it can be used in a pipe)
let dump = fn(grid) {
  for row in grid.rows {
    for cell in row {
      print(cell)
    }
    println()
  }
  grid
}

/// Returns cell at (x, y)
let at = fn(grid, x, y) {
  ensure_bounds(grid, x, y)
  grid.rows[y][x]
}

/// Returns cell at (x, y) or nil if out of bounds
let try_at = fn(grid, x, y) {
  if check_bounds(grid, x, y) {
    grid.rows[y][x]
  }
}

/// Returns a row of the grid
let row_at = fn(grid, y) {
  grid.rows[y]
}

/// Returns a column of the grid
let column_at = fn(grid, x) {
  range(0, grid.height) |> map(fn (y) { grid.rows[y][x] })
}

/// Puts a value at (x, y) and returns a new grid
let put = fn (grid, x, y, value) {
  var g = grid
  ensure_bounds(g, x, y)
  g.rows[y][x] = value
  g
}

/// Insert a row at position `y` and returns a new grid
let insert_row = fn(grid, y, row) {
  assert(len(row) == grid.width)
  assert(y >= 0 && y <= grid.height)
  let new_rows = take(grid.rows, y) + [row] + drop(grid.rows, y)
  Grid{rows: new_rows, width: grid.width, height: grid.height + 1}
}

/// Inserts a new column at position `x` and returns a new grid
let insert_column = fn(grid, x, column) {
  assert(len(column) == grid.height)
  assert(x >= 0 && x <= grid.width)
  let new_rows =
    range(0, grid.height)
    |> map(fn (y) {
      let row = grid.rows[y]
      take(row, x) + [column[y]] + drop(row, x)
    })
  Grid{rows: new_rows, width: grid.width + 1, height: grid.height}
}

/// Finds the first cell with value `target` and returns its coordinates
let find = fn(grid, target) {
  match Enum.find(grid, fn (x) { x[2] == target }) {
    (x, y, _) -> (x, y)
    nil -> nil
  }
}

/// Returns a list of neighbors for a cell at (x, y)
let neighbors = fn(grid, x, y) {
  ensure_bounds(grid, x, y)

  var res = []
  if check_bounds(grid, x - 1, y - 1) { res = res + [grid.rows[y-1][x-1]] }
  if check_bounds(grid, x, y - 1) { res = res + [grid.rows[y-1][x]] }
  if check_bounds(grid, x + 1, y - 1) { res = res + [grid.rows[y-1][x+1]] }
  if check_bounds(grid, x + 1, y) { res = res + [grid.rows[y][x+1]] }
  if check_bounds(grid, x + 1, y + 1) { res = res + [grid.rows[y+1][x+1]] }
  if check_bounds(grid, x, y + 1) { res = res + [grid.rows[y+1][x]] }
  if check_bounds(grid, x - 1, y + 1) { res = res + [grid.rows[y+1][x-1]] }
  if check_bounds(grid, x - 1, y) { res = res + [grid.rows[y][x-1]] }
  res
}

/// Returns a list valid coordinates for neighbors of the cell at (x, y)
let neighbor_coords = fn(grid, x, y) {
  ensure_bounds(grid, x, y)

  var res = []
  if check_bounds(grid, x - 1, y - 1) { res = res + [(x-1, y-1)] }
  if check_bounds(grid, x, y - 1) { res = res + [(x, y-1)] }
  if check_bounds(grid, x + 1, y - 1) { res = res + [(x+1, y-1)] }
  if check_bounds(grid, x + 1, y) { res = res + [(x+1, y)] }
  if check_bounds(grid, x + 1, y + 1) { res = res + [(x+1, y+1)] }
  if check_bounds(grid, x, y + 1) { res = res + [(x, y+1)] }
  if check_bounds(grid, x - 1, y + 1) { res = res + [(x-1, y+1)] }
  if check_bounds(grid, x - 1, y) { res = res + [(x-1, y)] }
  res
}

/// Returns iterator yielding (x, y, cell) for each cell
/// Iteration goes row by row
let __iter__ = fn(grid) {
  var x = 0
  var y = 0

  fn () {
    if y >= grid.height {
      nil
    } else {
      let res = (x, y, grid.rows[y][x])
      x = x + 1
      if x >= grid.width {
        x = 0
        y = y + 1
      }
      (some, res)
    }
  }
}

let check_bounds = fn(grid, x, y) {
  x >= 0 && y >= 0 && x < grid.width && y < grid.height
}

let ensure_bounds = fn(grid, x, y) {
  if !check_bounds(grid, x, y) {
    // TODO: print coordinate
    raise("out of bounds")
  }
}

// --- Tests ---

let tests = fn() {
  let input = "abc\ndef\nghi\n"
  let grid = Grid.parse(input)
  let expected_grid = ["abc", "def", "ghi"]

  // iter
  var iter_count = 0
  for (x, y, c) in grid {
    iter_count = iter_count + 1
    assert(expected_grid[y][x] == c)
  }
  assert(iter_count == 9)

  // at
  assert(at(grid, 2, 0) == "c")

  // try_at
  assert(try_at(grid, 3, 0) == nil)

  // row_at & column_at
  assert(row_at(grid, 1) == ["d", "e", "f"])
  assert(column_at(grid, 1) == ["b", "e", "h"])

  // find
  assert(find(grid, "b") == (1, 0))
  assert(find(grid, "z") == nil)

  // neighbors
  assert(neighbors(grid, 1, 1) == ["a", "b", "c", "f", "i", "h", "g", "d"])
  assert(neighbors(grid, 0, 0) == ["b", "e", "d"])

  // neighbor_coords
  assert(neighbor_coords(grid, 0, 0) == [(1, 0), (1, 1), (0, 1)])

  // mutations
  var grid2 =
    Grid.parse("d\n")
    |> Grid.insert_row(0, ["a"])
    |> Grid.insert_column(1, ["b", "e"])
    |> Grid.insert_column(2, ["c", "f"])
    |> Grid.insert_row(2, ["g", "h", "i"])

  assert(grid2 == grid)
}
tests()
