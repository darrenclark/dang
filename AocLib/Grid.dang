module AocLib/Grid

struct {
  rows,
  width,
  height
}

/// Parses from string containing a typical AoC grid of characters
let parse = fn(input) {
  let rows =
    input
    |> split("\n")
    |> filter(fn (l) { len(l) > 0 })
    |> map(to_list)

  let height = len(rows)
  let width = len(rows[0])

  for row in rows {
    assert(len(row) == width)
  }

  Grid{rows: rows, width: width, height: height}
}

/// Dumps a Grid to console for debugging.
/// Returns input (so it can be used in a pipe)
let dump = fn(grid) {
  for row in grid.rows {
    for cell in row {
      print(cell)
    }
    println()
  }
  grid
}

/// Returns cell at (x, y)
let at = fn(grid, x, y) {
  ensure_bounds(grid, x, y)
  grid.rows[y][x]
}

/// Returns cell at (x, y) or nil if out of bounds
let try_at = fn(grid, x, y) {
  if check_bounds(grid, x, y) {
    grid.rows[y][x]
  }
}

/// Returns a list of neighbors for a cell at (x, y)
let neighbors = fn(grid, x, y) {
  ensure_bounds(grid, x, y)

  var res = []
  if check_bounds(grid, x - 1, y - 1) { res = res + [grid.rows[y-1][x-1]] }
  if check_bounds(grid, x, y - 1) { res = res + [grid.rows[y-1][x]] }
  if check_bounds(grid, x + 1, y - 1) { res = res + [grid.rows[y-1][x+1]] }
  if check_bounds(grid, x + 1, y) { res = res + [grid.rows[y][x+1]] }
  if check_bounds(grid, x + 1, y + 1) { res = res + [grid.rows[y+1][x+1]] }
  if check_bounds(grid, x, y + 1) { res = res + [grid.rows[y+1][x]] }
  if check_bounds(grid, x - 1, y + 1) { res = res + [grid.rows[y+1][x-1]] }
  if check_bounds(grid, x - 1, y) { res = res + [grid.rows[y][x-1]] }
  res
}

/// Returns a list valid coordinates for neighbors of the cell at (x, y)
let neighbor_coords = fn(grid, x, y) {
  ensure_bounds(grid, x, y)

  var res = []
  if check_bounds(grid, x - 1, y - 1) { res = res + [(x-1, y-1)] }
  if check_bounds(grid, x, y - 1) { res = res + [(x, y-1)] }
  if check_bounds(grid, x + 1, y - 1) { res = res + [(x+1, y-1)] }
  if check_bounds(grid, x + 1, y) { res = res + [(x+1, y)] }
  if check_bounds(grid, x + 1, y + 1) { res = res + [(x+1, y+1)] }
  if check_bounds(grid, x, y + 1) { res = res + [(x, y+1)] }
  if check_bounds(grid, x - 1, y + 1) { res = res + [(x-1, y+1)] }
  if check_bounds(grid, x - 1, y) { res = res + [(x-1, y)] }
  res
}

/// Returns iterator yielding (x, y, cell) for each cell
/// Iteration goes row by row
let iter = fn(grid) {
  var x = 0
  var y = 0

  fn () {
    if y >= grid.height {
      nil
    } else {
      let res = (x, y, grid.rows[y][x])
      x = x + 1
      if x >= grid.width {
        x = 0
        y = y + 1
      }
      (some, res)
    }
  }
}

let check_bounds = fn(grid, x, y) {
  x >= 0 && y >= 0 && x < grid.width && y < grid.height
}

let ensure_bounds = fn(grid, x, y) {
  if !check_bounds(grid, x, y) {
    // TODO: print coordinate
    raise("out of bounds")
  }
}

// --- Tests ---

let tests = fn() {
  let input = "abc\ndef\nghi\n"
  let grid = Grid.parse(input)
  let expected_grid = ["abc", "def", "ghi"]

  // iter
  var iter_count = 0
  for (x, y, c) in grid {
    iter_count = iter_count + 1
    assert(expected_grid[y][x] == c)
  }
  assert(iter_count == 9)

  // at
  assert(at(grid, 2, 0) == "c")

  // try_at
  assert(try_at(grid, 3, 0) == nil)

  // neighbors
  assert(neighbors(grid, 1, 1) == ["a", "b", "c", "f", "i", "h", "g", "d"])
  assert(neighbors(grid, 0, 0) == ["b", "e", "d"])

  // neighbor_coords
  assert(neighbor_coords(grid, 0, 0) == [(1, 0), (1, 1), (0, 1)])

}
tests()
