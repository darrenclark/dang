WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

source_file = _{ SOI ~ stmt* ~ EOI }

body = { "{" ~ stmt* ~ "}" }

keywords = {
  "false" |
  "fn" |
  "let" |
  "true" |
  "var"
}

identifier = @{ !keywords ~ !ASCII_DIGIT ~ (ASCII_ALPHANUMERIC | "_")+ }

stmt = _{ let_stmt | var_stmt | assignment | if_stmt | expr }

let_stmt = { "let" ~ identifier ~ "=" ~ expr }
var_stmt = { "var" ~ identifier ~ "=" ~ expr }
assignment = { identifier ~ "=" ~ expr }
if_stmt = {
  "if" ~
  #cond = expr ~
  #if_body = body ~
  ( "else" ~ ( #else_if = if_stmt | #else_body = body ) )?
}

expr = { prefix? ~ primary ~ (infix ~ prefix? ~ primary )* }
  infix    =  _{ mul | div | add | sub | gt | gte | lt | lte | eq | neq | logical_and | logical_or }
    mul    =   { "*" } // Multiplication
    div    =   { "/" } // Division
    add    =   { "+" } // Addition
    sub    =   { "-" } // Subtraction
    gt     =   { ">" }
    gte    =   { ">=" }
    lt     =   { "<" }
    lte    =   { "<=" }
    eq     =   { "==" }
    neq    =   { "!=" }
    logical_and = { "&&" }
    logical_or  = { "||" }
  prefix   =  _{ neg }
    neg    =   { "-" } // Integer regation
    logical_neg = { "!" } // logical negation
  primary  =  _{ term | "(" ~ expr ~ ")" }

term = _{
  function_literal |
  function_call |
  identifier |
  bool_literal |
  string_literal |
  number_literal
}

function_literal = { "fn" ~ arg_names ~ "{" ~ stmt* ~ "}" }

arg_names = {
  "(" ~ ")" |
  "(" ~ identifier ~ ("," ~ identifier)* ~ ")"
}

function_call = { identifier ~ args }

args = {
  "(" ~ ")" |
  "(" ~ expr ~ ("," ~ expr)* ~ ")"
}

string_literal = ${ "\"" ~ string_contents ~ "\"" }
string_contents = @{ char* }
char = _{
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}

number_literal = @{
    "-"?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ ("." ~ ASCII_DIGIT*)?
    ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

bool_literal = { "true" | "false" }
