__builtin inspect
__builtin str
__builtin println

println(str(true))
println(str(false))
"hello" |> println(" ", "world")

let a = 3
let b = 5
let c = 40

var d = 0
d = d + c
d = d + 5

let y = true && "it works!"
inspect(y)

let result = inspect(d) / inspect(a * -b)

if result > 0 {
  println("positive")
  1
} else {
  println("negative")
  -1
}

let add_plus_ten = fn(a, b) {
  let c = 10
  a + b + c
}
add_plus_ten(5, 2)

(1, 2, 3)

let l = [1, 2, 3, 4]
let l2 = [a, b, c, d]

let di = {a: 1, b: {c: 2}}

println("di.a  = ", di.a)
println("di[b].c = ", di["b"].c)

{result: (l, l2), add_plus_ten: add_plus_ten}
