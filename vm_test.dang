module VmTest

import Std/Builtins.*
import Std/Range.range

import Std/Builtins.some

struct {
  x,
  y,
  z
}


var iter_state = 0
let iter = fn (t) {
  fn () {
    if iter_state == 0 {
      iter_state = 1
      (some, 11)
    } else if iter_state == 1 {
      iter_state = 2
      (some, 22)
    } else if iter_state == 2 {
      iter_state = 3
      (some, 33)
    } else {
      nil
    }
  }
}

VmTest{x: 1, y: 2, z: 3}
|> inspect()

println(str(true))
println(str(false))
"hello" |> println(" ", "world")

let a = 3
let b = 5
let c = 40

var d = 0
d = d + c
d = d + 5

let y = true && "it works!"
inspect(y)

let result = inspect(d) / inspect(a * -b)

if result > 0 {
  println("positive")
  1
} else {
  println("negative")
  -1
}

let add_plus_ten = fn(a, b) {
  let c = 10
  a + b + c
}
add_plus_ten(5, 2)

(1, 2, 3)

let l = [1, 2, 3, 4]
let l2 = [a, b, c, d]

var di = {a: 1, b: {c: 2}}

println("di.a  = ", di.a)
println("di[b].c = ", di["b"].c)

di.b.c = 3
inspect(di)

{result: (l, l2), add_plus_ten: add_plus_ten}

