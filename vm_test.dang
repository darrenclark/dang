__builtin inspect
__builtin str
__builtin println

println(str(true))
println(str(false))
"hello" |> println(" ", "world")

let a = 3
let b = 5
let c = 40

var d = 0
d = d + c
d = d + 5

let y = true && "it works!"
inspect(y)

let result = inspect(d) / inspect(a * -b)

if result > 0 {
  println("positive")
  1
} else {
  println("negative")
  -1
}
