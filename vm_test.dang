print("tail call optimization... ")

let tc = fn(n) {
  if n > 100000 {
    println("works!")
  } else {
    tc(n + 1)
  }
}

tc(0)

println("====")

[1, 2, 3]
|> Stream.map(fn (x) {
  println(x, " * 2")
  x * 2
})
|> Stream.map(fn (x) {
  println(x, " + 5")
  x + 5
})
|> to_list()
|> inspect()

[1, 2, 3]
|> Stream.flat_map(fn (x) {
  [x, x, x]
})
|> to_list()
|> inspect()

var si = 0

Stream.cycle([1, 2, 3])
|> Stream.take_while(fn (x) {
  si = si + x

  si < 1000
})
|> count()
|> inspect()
