// let ((a, b), (c, (d, e), f)) = result
//
// if each instruction unpacks previous tuple
//
// Constant       // result
// PatBegin       // result
// PatTuple 2  0  // result, _0.0, _0.1
// PatTuple 2  1  // result, _0.0, _0.1, a, b
// PatTuple 3  2  // result, _0.0, _0.1, a, b, c, _1.1, f
// PatTuple 2  1  // result, _0.0, _0.1, a, b, c, _1.1, f, d, e
// PatEnd         // result, _0.0, _0.1, a, b, c, _1.1, f, d, e

// let ((a, b), (c, (d, e), f)) = result
//
// if each instruction unpacks previous tuple & deletes from the stack
//
// Constant       // result
// PatBegin       // result
// PatTuple 2  0  // _0.0, _0.1
// PatTuple 2  1  // _0.1, a, b
// PatTuple 3  2  // a, b, c, _1.1, f
// PatTuple 2  1  // a, b, c, f, d, e
// PatEnd         // a, b, c, f, d, e

