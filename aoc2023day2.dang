let parse = fn(input) {
  input
  |> split("\n")
  |> filter(fn (l) { len(l) > 0 })
  |> map(fn (l) {
    let parts = split(line, ":")
    let game_id = parts[0] |> split(" ") |> get(1) |> int()

    let pulls = parts[1] |> str_replace(";", ",") |> split(",") |> map(trim) |> map(fn (p) {
      let ps = split(p, " ")
      {color: ps[1], count: int(ps[0])}
    })

    {id: id, pulls: pulls}
  })
}

let part1 = fn(parsed) {
  parsed |> map(check_valid_game) |> sum()
}

let part2 = fn(parsed) {
  0
}

let max_red = 12
let max_green = 13
let max_blue = 14

let valid_pull? = fn(pull) {
  let parts = split(pull, " ")
  let count = int(parts[0])
  let color = parts[1]

  if color == "red" {
    count <= max_red
  } else if color == "blue" {
    count <= max_blue
  } else if color == "green" {
    count <= max_green
  } else {
    raise("unexpected color: " + color)
  }
}

let check_valid_game = fn(line) {
  let parts = split(line, ":")
  let pulls = parts[1] |> str_replace(";", ",") |> split(",") |> map(trim)

  if all?(pulls, valid_pull?) {
    parts[0] |> split(" ") |> get(1) |> int()
  } else {
    0
  }
}

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
