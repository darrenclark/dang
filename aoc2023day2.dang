let parse = fn(input) {
  input
  |> split("\n")
  |> filter(fn (l) { len(l) > 0 })
  |> map(fn (l) {
    let parts = split(l, ":")
    let id = parts[0] |> split(" ") |> get(1) |> int()

    let pulls = parts[1] |> str_replace(";", ",") |> split(",") |> map(trim) |> map(fn (p) {
      let ps = split(p, " ")
      {color: ps[1], count: int(ps[0])}
    })

    {id: id, pulls: pulls}
  })
}

let part1 = fn(parsed) {
  parsed |> map(check_valid_game) |> sum()
}

let part2 = fn(parsed) {
  parsed |> map(min_power_for_game) |> sum()
}

let max_red = 12
let max_green = 13
let max_blue = 14

let valid_pull? = fn(pull) {
  if pull.color == "red" {
    pull.count <= max_red
  } else if pull.color == "blue" {
    pull.count <= max_blue
  } else if pull.color == "green" {
    pull.count <= max_green
  } else {
    raise("unexpected color: " + color)
  }
}

let check_valid_game = fn(game) {
  if all?(game.pulls, valid_pull?) {
    game.id
  } else {
    0
  }
}

let min_power_for_game = fn(game) {
  min_cubes(game, "red") * min_cubes(game, "green") * min_cubes(game, "blue")
}

let min_cubes = fn(game, color) {
  game.pulls
  |> filter(fn (p) { p.color == color })
  |> map(fn (p) { p.count })
  |> max()
}

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
