let items = [false, 1] + ["two", 3]

inspect(items)
print("Length: ")
inspect(len(items))

print("Second element: ")
inspect(get(items, 1))

print("Length of 'hello, world': ")
inspect(len("hello, world"))

let grid = [
  "123",
  "456",
  "789"
]

print("Grid at x=2,y=1: ")
inspect(get(grid, 1, 2))

let people = [
  "Alice",
  "Bob",
  "Charlie"
]

for p in people {
  println("Hello, ", p)
}
