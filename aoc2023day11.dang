import AocLib/Parse
import AocLib/Grid

let parse = fn(input) {
  Grid.parse(input)
}

let part1 = fn(parsed) {
  let expansions = expand(parsed)

  parsed
  |> galaxy_pairs()
  |> Stream.map(fn (pair) {
    distance(parsed, expansions, 1, pair[0], pair[1])
  })
  |> sum()
}

let part2 = fn(parsed) {
  let expansions = expand(parsed)

  parsed
  |> galaxy_pairs()
  |> Stream.map(fn (pair) {
    distance(parsed, expansions, 999999, pair[0], pair[1])
  })
  |> sum()
}

let expand = fn(grid) {
  var expansions = {rows: {}, cols: {}}

  for x in range(0, grid.width) |> to_list() |> reverse() {
    let col = Grid.column_at(grid, x)
    if unique(col) == ["."] {
      expansions.cols[x] = true
    }
  }

  for y in range(0, grid.height) |> to_list() |> reverse() {
    let row = Grid.row_at(grid, y)
    if unique(row) == ["."] {
      expansions.rows[y] = true
    }
  }

  expansions
}

let galaxy_pairs = fn(grid) {
  let galaxies =
    grid
    |> filter(fn(x) { x[2] == "#" })
    |> map(fn(x) { (x[0], x[1]) })

  range(0, len(galaxies))
  |> Stream.flat_map(fn (i) {
    range(i + 1, len(galaxies))
    |> Stream.map(fn (j) { (galaxies[i], galaxies[j]) })
  })
}

let distance = fn(grid, expansions, expansion_size, a, b) {
  var dx = Math.abs(a[0] - b[0])
  var dy = Math.abs(a[1] - b[1])

  if dx != 0 {
    let left = Math.min(a[0], b[0])
    let right = Math.max(a[0], b[0])
    dx = dx + expansions_between(expansions.cols, left, right) * expansion_size
  }

  if dy != 0 {
    let top = Math.min(a[1], b[1])
    let bottom = Math.max(a[1], b[1])
    dy = dy + expansions_between(expansions.rows, top, bottom) * expansion_size
  }

  dx + dy
}

let expansions_between = fn(expansions, a, b) {
  var extra = 0
  for x in range(a + 1, b) {
    if expansions[x] {
      extra = extra + 1
    }
  }
  extra
}

// --------------

let input_path = first(argv())
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
