import AocLib/Parse

import Std/CountedSet

let parse = fn(input) {
  input
  |> Parse.lines()
  |> map(fn (l) {
    let (hand, bid) = Parse.tuple(l, " ")

    {hand: to_list(hand), bid: int(bid)}
  })
}

let part1 = fn(parsed) {
  let ranked =
    parsed
    |> sort_by(fn (h) { strength(h.hand) })

  var res = 0
  for (i, h) in enumerate(ranked) {
    res = res + h.bid * (i + 1)
  }
  res
}

let part2 = fn(parsed) {
  let ranked =
    parsed
    |> sort_by(fn (h) { strength_pt2(h.hand) })

  var res = 0
  for (i, h) in enumerate(ranked) {
    res = res + h.bid * (i + 1)
  }
  res
}

let strength = fn(hand) {
  (
    hand_strength(hand),
    card_strength(hand[0]),
    card_strength(hand[1]),
    card_strength(hand[2]),
    card_strength(hand[3]),
    card_strength(hand[4]),
  )
}

let hand_strength = fn(hand) {
  let counts = CountedSet.new(hand) |> CountedSet.item_counts()

  if len(counts) == 1 {
    // flush
    7
  } else if len(counts) == 2 {
    // four of a kind or full house
    if counts[0][0] == 4 {
      6
    } else {
      5
    }
  } else if len(counts) == 3 {
    // three of a kind or two pair
    if counts[0][0] == 3 {
      4
    } else {
      3
    }
  } else if len(counts) == 4 {
    // one pair
    2
  } else {
    // high card
    1
  }
}

let card_strength = fn(card) {
  if card == "A" { 14 }
  else if card == "K" { 13 }
  else if card == "Q" { 12 }
  else if card == "J" { 11 }
  else if card == "T" { 10 }
  else { int(card) }
}

let strength_pt2 = fn(hand) {
  (
    hand_strength_pt2(hand, 0),
    card_strength_pt2(hand[0]),
    card_strength_pt2(hand[1]),
    card_strength_pt2(hand[2]),
    card_strength_pt2(hand[3]),
    card_strength_pt2(hand[4]),
  )
}

let cards_minus_j = ["A", "K", "Q", "T", "9", "8", "7", "6", "5", "4", "3", "2"]

let hand_strength_pt2 = fn(hand, i) {
  if i > 4 {
    hand_strength(hand)
  } else if hand[i] != "J" {
    hand_strength_pt2(hand, i + 1)
  } else {
    var strength = 0

    for card in cards_minus_j {
      var new_hand = hand
      new_hand[i] = card
      let s = hand_strength_pt2(new_hand, i + 1)
      if s > strength {
        strength = s
      }
    }

    strength
  }
}

let card_strength_pt2 = fn(card) {
  if card == "J" { 0 }
  else { card_strength(card) }
}

// --------------

let input_path = first(argv())
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
