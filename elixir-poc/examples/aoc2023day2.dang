(let empty-of (fn (arg)
  (if (is? arg str) ""
   elseif (is? arg list) (list)
   else (raise "not an enumerable type"))
))

(let append-element (fn (enum elem)
  (if (is? enum str) (+ enum elem)
   elseif (is? enum list) (+ enum (list elem))
   else (raise "not an enumerable type"))
))

(let map (fn (enum func)
 (let result (empty-of enum))
 (for x enum (do
   (set result (append-element result (func x)))
 ))
 (return result)
))

(let reduce (fn (enum initial-acc func)
 (let acc initial-acc)
 (for x enum (do
   (set acc (func x acc))
 ))
 (return acc)
))

(let filter (fn (enum func)
 (let result (empty-of enum))
 (for x enum (do
   (if (func x)
     (set result (append-element result x)))
 ))
 (return result)
))

(let drop (fn (enum n)
 (let i 0)
 (let result (empty-of enum))
 (for x enum (do
   (if (>= i n)
     (set result (append-element result x)))
   (set i (+ i 1))
 ))
 (return result)
))

(let all? (fn (enum func)
 (for x enum (do
   (if (func x) nil else (return false))
 ))
 (return true)
))

(let replace (fn (enum item replacement)
  (map enum (fn (x)
    (if (== x item) replacement else x)))
))

; let max_red = 12
; let max_green = 13
; let max_blue = 14

(let max-red 12)
(let max-green 13)
(let max-blue 14)

; let input_path = first(argv)
; if input_path == nil { raise("Expected path to input as first arg") }

(let input-path (first argv))
(if (== input-path nil) (raise "Expected path to input as first arg"))

; let input = readfile(input_path)

(let input (readfile input-path))

; var parsed = split(input, "\n")
; parsed = filter(parsed, fn(l) { len(l) > 0 })

(var parsed (split input "\n"))
(set parsed (filter parsed (fn (l) (> (len l) 0))))

; let valid_pull? = fn(pull) {
;   let parts = split(pull, " ")
;   let count = int(parts[0])
;   let color = parts[1]
; 
;   if color == "red" {
;     count <= max_red
;   } else if color == "blue" {
;     count <= max_blue
;   } else if color == "green" {
;     count <= max_green
;   } else {
;     raise("unexpected color: " + color)
;   }
; }

(let valid-pull? (fn (pull)
  (let parts (split pull " "))
  (let count (int (at 0 parts)))
  (let color (at 1 parts))

  (if (== color "red") (<= count max-red)
   elseif (== color "blue") (<= count max-blue)
   elseif (== color "green") (<= count max-green)
   else (raise (+ "unexpected color: " color)))
))

; let check_valid_game = fn(line) {
;   let parts = split(line, ":")
;   let pulls = parts[1] |> replace(";", ",") |> split(",") |> map(trim)
;
;   if all?(pulls, valid_pull?) {
;     return parts[0] |> split(" ") |> int()
;   } else {
;     return 0
;   }
; }

(let check-valid-game (fn (line)
  (let parts (split line ":"))
  (let pulls (map (split (replace (at 1 parts) ";" ",") ",") trim))

  (let all-valid? (all? pulls valid-pull?))

  (let game-id (int (at 1 (split (at 0 parts) " "))))

  (if all-valid? game-id else 0)
))

; let game_ids = parsed |> map(check_valid_game)

(let game-ids (map parsed check-valid-game))

; print ("Sum of valid game IDs: ", reduce(game_ids, 0, +))

(print "Sum of valid game IDs: " (reduce game-ids 0 +))
