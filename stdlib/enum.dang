let map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + [func(x)]
  }
  result
}

let reduce = fn(enum, acc, func) {
  var result = acc
  for x in enum {
    result = func(x, result)
  }
  result
}

let filter = fn(enum, func) {
  var result = []
  for x in enum {
    if func(x) {
      result = result + [x]
    }
  }
  result
}

let first = fn(enum) {
  if len(enum) > 0 {
    get(enum, 0)
  } else {
    nil
  }
}

let last = fn(enum) {
  if len(enum) > 0 {
    get(enum, len(enum)-1)
  } else {
    nil
  }
}

let sum = fn(enum) {
  reduce(enum, 0, fn(x, acc) { acc + x })
}
