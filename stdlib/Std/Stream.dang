module Std/Stream

import Std/Builtins.some
import Std/Builtins.is_tuple
import Std/Builtins
import Std/Builtins.inspect
import Std/Builtins.println

struct {
  _iter
}

let __iter__ = fn(s) {
  s._iter
}

/// Repeat a value infinitely
let repeat = fn(x) {
  let it = fn () {
    (some, x)
  }

  Stream{_iter: it}
}

/// Cycle a list of elements infinitely
let cycle = fn(ls) {
  ls
  |> repeat()
  |> flat_map(fn(x) { x })
}

/// Filter a stream based on a predicate
let filter = fn(iterable, f) {
  let inner = Builtins.iter(iterable)
  let it = fn () {
    _filter(inner, f)
  }
  Stream{_iter: it}
}

let _filter = fn(it, f) {
  match it() {
    (some, x) if f(x) -> (some, x),
    (some, _) -> _filter(it, f),
    nil -> nil
  }
}

/// Map a function over a stream
let map = fn(iterable, f) {
  let inner = Builtins.iter(iterable)

  let it = fn () {
    let next = inner()
    if is_tuple(next, 2) {
      let (_, x) = next
      (some, f(x))
    } else {
      nil
    }
  }

  Stream{_iter: it}
}

/// Map a function over a stream and flatten the result
let flat_map = fn(iterable, f) {
  let source = Builtins.iter(iterable)

  var current = nil

  let it = fn () {
    let (new_current, res) = _flat_map(source, current, f)
    current = new_current
    res
  }

  Stream{_iter: it}
}

let _flat_map = fn (source, current, f) {
  if current == nil {
    let next_elem_from_source = source()
    if is_tuple(next_elem_from_source, 2) {
      let (_, x) = next_elem_from_source
      _flat_map(source, Builtins.iter(f(x)), f)
    } else {
      (nil, nil)
    }
  } else {
    let next_result_elem = current()
    if is_tuple(next_result_elem, 2) {
      (current, next_result_elem)
    } else {
      _flat_map(source, nil, f)
    }
  }
}

/// Emits (index, item) pair for each item in the stream
let enumerate = fn(iterable) {
  let inner = Builtins.iter(iterable)
  var index = 0
  let it = fn () {
    match inner() {
      (_, x) -> {
        let res = (index, x)
        index = index + 1
        (:item, res)
      }
      nil -> nil
    }
  }
  Stream{_iter: it}
}

/// Skip the first n elements of a stream
let drop = fn(iterable, n) {
  let inner = Builtins.iter(iterable)
  var count = 0

  filter(iterable, fn(x) {
    if count < n {
      count = count + 1
      false
    } else {
      true
    }
  })
}

/// Takes the first n elements of a stream
let take = fn(iterable, n) {
  let inner = Builtins.iter(iterable)
  var count = 0
  take_while(iterable, fn(x) {
    if count < n {
      count = count + 1
      true
    } else {
      false
    }
  })
}

/// Takes elements from a stream while the predicate returns true
let take_while = fn(iterable, f) {
  let inner = Builtins.iter(iterable)

  let it = fn () {
    let next = inner()
    if is_tuple(next, 2) {
      let (_, x) = next
      if f(x) {
        next
      } else {
        nil
      }
    } else {
      nil
    }
  }

  Stream{_iter: it}
}

/// Taks elements from a stream until the predicate returns true
let take_until = fn(iterable, f) {
  take_while(iterable, fn(x) { !f(x) })
}

/// Zip two iterables together lazily
let zip = fn(a, b) {
  let a_iter = Builtins.iter(a)
  let b_iter = Builtins.iter(b)
  let it = fn () {
    let a_next = a_iter()
    let b_next = b_iter()
    match (a_next, b_next) {
      (_, nil) -> nil,
      (nil, _) -> nil,
      ((_, a), (_, b)) -> (:some, (a, b))
    }
  }
  Stream{_iter: it}
}

/// Repeatedly calls f to produce a sequence of values
///
/// If f returns (value, new_state) then the value is yielded and the
/// new state is used for the next iteration
///
/// If f returns nil then the sequence is terminated
let unfold = fn(init, f) {
  var state = init
  let it = fn () {
    match f(state) {
      (value, new_state) -> {
        state = new_state
        (:some, value)
      }
      nil -> nil
    }
  }
  Stream{_iter: it}
}

/// Concat two streams together
let concat = fn(a, b) {
  flat_map([a, b], fn(x) { x })
}
