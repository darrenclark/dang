module Std/Enum

import Std/Builtins.*
import Std/Range.range

let count = fn(enum) {
  // TODO: optimize for strings, list, dict, tuple
  var count = 0
  for _ in enum {
    count = count + 1
  }
  count
}

let map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + [func(x)]
  }
  result
}

let flat_map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + to_list(func(x))
  }
  result
}

let reduce = fn(enum, acc, func) {
  var result = acc
  for x in enum {
    result = func(x, result)
  }
  result
}

/// Reduce without an initial value
let fold = fn(enum, func) {
  let it = iter(enum)

  let n = it()
  var acc = nil
  if is_tuple(n, 2) {
    let (_, e) = n
    acc = e
  } else {
    raise("fold requires at least one element")
  }

  reduce(it, acc, func)
}

let filter = fn(enum, func) {
  var result = []
  for x in enum {
    if func(x) {
      result = result + [x]
    }
  }
  result
}

let first = fn(enum) {
  if len(enum) > 0 {
    get(enum, 0)
  } else {
    nil
  }
}

let last = fn(enum) {
  if len(enum) > 0 {
    get(enum, len(enum)-1)
  } else {
    nil
  }
}

let drop = fn (enum, n) {
  var result = []
  for i in range(n, len(enum)) {
    result = result + [get(enum, i)]
  }
  result
}

let sum = fn(enum) {
  reduce(enum, 0, fn(x, acc) { acc + x })
}

let all? = fn(enum, func) {
  var result = true
  // TODO: break out of iteration early
  for x in enum {
    if result && !func(x) {
      result = false
    }
  }
  result
}

let any? = fn(enum, func) {
  var result = false
  // TODO: break out of iteration early
  for x in enum {
    if !result && func(x) {
      result = true
    }
  }
  result
}

let min = fn(enum) {
  var result = first(enum)
  for x in enum {
    if x < result { result = x }
  }
  result
}

let max = fn(enum) {
  var result = first(enum)
  for x in enum {
    if x > result { result = x }
  }
  result
}

let enumerate = fn(enum) {
  var i = 0
  map(enum, fn (x) {
    let result = (i, x)
    i = i + 1
    result
  })
}

let unique = fn(enum) {
  var seen = {}
  var result = []
  for x in enum {
    if !seen[x] {
      seen[x] = true
      result = result + [x]
    }
  }
  result
}

let join = fn(enum) {
  reduce(enum, "", fn(x, acc) { acc + x })
}

let sort = fn(enum) {
  sort_impl(to_list(enum))
}

let sort_by = fn(enum, selector) {
  enum
  |> map(fn(x) { (selector(x), x) })
  |> sort_impl()
  |> map(fn(x) { x[1] })
}

let to_list = fn(enum) {
  // TODO: skip if already a list

  var result = []
  for x in enum {
    result = result + [x]
  }
  result
}

let to_dict = fn(enum) {
  var result = {}

  for (k, v) in enum {
    result[k] = v
  }

  result
}

/// Zip two sequences together
let zip = fn(enum1, enum2) {
  var it1 = iter(enum1)
  var it2 = iter(enum2)
  _zip(it1, it2, it1(), it2(), [])
}

let _zip = fn(it1, it2, next1, next2, acc) {
  match (next1, next2) {
    (_, nil) -> acc
    (nil, _) -> acc
    ((_, x1), (_, x2)) -> _zip(it1, it2, it1(), it2(), acc + [(x1, x2)])
  }
}

/// Find the first element that satisfies the predicate
let find = fn(enum, pred) {
  let it = iter(enum)
  _find(it, it(), pred)
}

let _find = fn(it, next, pred) {
  match next {
    nil -> nil
    (_, x) if pred(x) -> x
    _ -> _find(it, it(), pred)
  }
}
