module Std/Enum

import Std/Builtins.*
import Std/Range.range

let map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + [func(x)]
  }
  result
}

let flat_map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + to_list(func(x))
  }
  result
}

let reduce = fn(enum, acc, func) {
  var result = acc
  for x in enum {
    result = func(x, result)
  }
  result
}

let filter = fn(enum, func) {
  var result = []
  for x in enum {
    if func(x) {
      result = result + [x]
    }
  }
  result
}

let first = fn(enum) {
  if len(enum) > 0 {
    get(enum, 0)
  } else {
    nil
  }
}

let last = fn(enum) {
  if len(enum) > 0 {
    get(enum, len(enum)-1)
  } else {
    nil
  }
}

let drop = fn (enum, n) {
  var result = []
  for i in range(n, len(enum)) {
    result = result + [get(enum, i)]
  }
  result
}

let sum = fn(enum) {
  reduce(enum, 0, fn(x, acc) { acc + x })
}

let all? = fn(enum, func) {
  var result = true
  // TODO: break out of iteration early
  for x in enum {
    if result && !func(x) {
      result = false
    }
  }
  result
}

let min = fn(enum) {
  var result = first(enum)
  for x in enum {
    if x < result { result = x }
  }
  result
}

let max = fn(enum) {
  var result = first(enum)
  for x in enum {
    if x > result { result = x }
  }
  result
}

let enumerate = fn(enum) {
  var i = 0
  map(enum, fn (x) {
    let result = (i, x)
    i = i + 1
    result
  })
}

let unique = fn(enum) {
  var seen = {}
  var result = []
  for x in enum {
    if !seen[x] {
      seen[x] = true
      result = result + [x]
    }
  }
  result
}

let join = fn(enum) {
  reduce(enum, "", fn(x, acc) { acc + x })
}

let sort = fn(enum) {
  sort_impl(to_list(enum))
}

let sort_by = fn(enum, selector) {
  enum
  |> map(fn(x) { (selector(x), x) })
  |> sort_impl()
  |> map(fn(x) { x[1] })
}

let to_list = fn(enum) {
  // TODO: skip if already a list

  var result = []
  for x in enum {
    result = result + [x]
  }
  result
}
