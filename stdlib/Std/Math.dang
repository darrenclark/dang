module Std/Math

/// rem(a, b) - remainder of dividing a by b
__builtin rem

/// Absolute value
let abs = fn(x) {
    if x < 0 {
        -x
    } else {
        x
    }
}

/// Minimum of two values
let min = fn(a, b) {
    if a < b {
        a
    } else {
        b
    }
}

/// Maximum of two values
let max = fn(a, b) {
    if a > b {
        a
    } else {
        b
    }
}

/// Greatest common divisor of two integers
let gcd = fn(a, b) {
    if b == 0 {
        a
    } else {
        gcd(b, rem(a, b))
    }
}

/// Least common multiple
let lcm = fn(a, b) {
    a * b / gcd(a, b)
}
