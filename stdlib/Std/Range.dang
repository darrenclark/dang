module Std/Range

import Std/Builtins.some

/// Sequence of all `i` for which `begin <= i < end` is valid
/// `i` is incremented by `step`
struct {
  begin,
  end,
  step: 1
}

__builtin _range_iter

let new = fn(begin, end, step) {
  Range{begin: begin, end: end, step: step}
}

let range = fn(begin, end) {
  Range{begin: begin, end: end}
}

let __iter__ = fn(range) {
  _range_iter(range.begin, range.end, range.step)
}
