import AocLib/Grid

let parse = fn(input) {
  input
  |> Grid.parse()
  |> Grid.dump()
}

let part1 = fn(grid) {
  var last_y = -1
  var number = ""
  var is_part_number = false

  var sum = 0

  for (x, y, c) in grid {
    if last_y != y || !is_digit?(c) {
      if is_part_number {
        sum = sum + int(number)
      }

      last_y = y
      is_part_number = false
      number = ""
    }

    if is_digit?(c) {
      number = number + c

      for n in Grid.neighbors(grid, x, y) {
        is_part_number = is_part_number || (n != "." && !is_digit?(n))
      }
    }
  }

  if is_part_number {
    sum = sum + int(number)
  }

  sum
}

let part2 = fn(grid) {
  ""
}


let is_digit? = fn(c) {
  c >= "0" && c <= "9"
}

// --------------

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
