import AocLib/Grid

let parse = fn(input) {
  input
  |> Grid.parse()
}

let part1 = fn(grid) {
  var last_y = -1
  var number = ""
  var is_part_number = false

  var sum = 0

  for (x, y, c) in grid {
    if last_y != y || !is_digit?(c) {
      if is_part_number {
        sum = sum + int(number)
      }

      last_y = y
      is_part_number = false
      number = ""
    }

    if is_digit?(c) {
      number = number + c

      for n in Grid.neighbors(grid, x, y) {
        is_part_number = is_part_number || (n != "." && !is_digit?(n))
      }
    }
  }

  if is_part_number {
    sum = sum + int(number)
  }

  sum
}

let part2 = fn(grid) {
  // (x,y) -> [number]
  var possible_gears = {}

  var last_y = -1
  var number = ""
  // [(x,y)]
  var touching_gears = []

  for (x, y, c) in grid {
    if last_y != y || !is_digit?(c) {
      for gear in unique(touching_gears) {
        possible_gears[gear] = append(possible_gears[gear] || [], int(number))
      }

      last_y = y
      number = ""
      touching_gears = []
    }

    if is_digit?(c) {
      number = number + c

      for (gx, gy) in Grid.neighbor_coords(grid, x, y) {
        if Grid.at(grid, gx, gy) == "*" {
          touching_gears = append(touching_gears, (gx, gy))
        }
      }
    }
  }

  for gear in unique(touching_gears) {
    possible_gears[gear] = append(possible_gears[gear] || [], int(number))
  }

  possible_gears
  |> filter(fn(kv) { len(kv[1]) == 2 })
  |> map(fn(kv) { kv[1][0] * kv[1][1] })
  |> sum()
}


let is_digit? = fn(c) {
  c >= "0" && c <= "9"
}

// --------------

let input_path = first(argv())
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
