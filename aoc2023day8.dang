import AocLib/Parse

let parse = fn(input) {
  let lines = Parse.lines(input)

  let instructions = to_list(lines[0])

  let nodes =
    lines
    |> drop(1)
    |> map(fn(line) {
      let (node, edges_str) = Parse.tuple(line, " = ")
      let edges = edges_str |> str_replace("(", "") |> str_replace(")", "") |> Parse.tuple(",")

      (node, edges)
    })
    |> to_dict()

  {instructions: instructions, nodes: nodes}
}

let part1 = fn(parsed) {
  count_until(parsed, "AAA", fn (n) { n == "ZZZ" })
}

let part2 = fn(parsed) {
  parsed.nodes
  |> filter(fn (kv) { str_ends_with?(kv[0], "A") })
  |> map(fn (kv) { kv[0] })
  |> map(fn (start) { count_until(parsed, start, fn (n) { str_ends_with?(n, "Z") }) })
  |> fold(Math.lcm)
}

let count_until = fn(parsed, start, predicate) {
  var node = start

  let c =
    parsed.instructions
    |> Stream.cycle()
    |> Stream.map(fn (i) {
      if i == "L" {
        node = parsed.nodes[node][0]
      } else if i == "R" {
        node = parsed.nodes[node][1]
      }

      node
    })
    |> Stream.take_until(predicate)
    |> count()

  // +1 since take_while exits before counting the last step
  c + 1
}


// --------------

let input_path = first(argv())
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
