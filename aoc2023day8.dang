import AocLib/Parse

let parse = fn(input) {
  let lines = Parse.lines(input)

  let instructions = to_list(lines[0])

  let nodes =
    lines
    |> drop(1)
    |> map(fn(line) {
      let (node, edges_str) = Parse.tuple(line, " = ")
      let edges = edges_str |> str_replace("(", "") |> str_replace(")", "") |> Parse.tuple(",")

      (node, edges)
    })
    |> to_dict()

  {instructions: instructions, nodes: nodes}
}

let part1 = fn(parsed) {
  var node = "AAA"

  let count =
    parsed.instructions
    |> Stream.cycle()
    |> Stream.take_while(fn (i) {
      if i == "L" {
        node = parsed.nodes[node][0]
      } else if i == "R" {
        node = parsed.nodes[node][1]
      }

      node != "ZZZ"
    })
    |> Stream.count()

  count
}

let part2 = fn(parsed) {
  ""
}


// --------------

let input_path = first(argv())
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
