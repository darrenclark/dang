let map = fn(enum, func) {
  var result = []
  for x in enum {
    result = result + [func(x)]
  }
  result
}

let reduce = fn(enum, acc, func) {
  var result = acc
  for x in enum {
    result = func(x, result)
  }
  result
}

let filter = fn(enum, func) {
  var result = []
  for x in enum {
    if func(x) {
      result = result + [x]
    }
  }
  result
}

let first = fn(enum) {
  if len(enum) > 0 {
    get(enum, 0)
  } else {
    nil
  }
}

let last = fn(enum) {
  if len(enum) > 0 {
    get(enum, len(enum)-1)
  } else {
    nil
  }
}

let is_digit = fn(ch) {
  ch >= "0" && ch <= "9"
}

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }

let input = readfile(input_path)

var parsed = split(input, "\n")
parsed = filter(parsed, fn(l) { len(l) > 0 })

let calibration_value = fn(line) {
  let digits_only = filter(line, is_digit)
  let value = first(digits_only) + last(digits_only)
  int(value)
}

let values = map(parsed, calibration_value)

println("Sum of calibration values: ", reduce(values, 0, fn(x, acc) { x + acc }))
