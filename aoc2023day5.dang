import AocLib/Parse

let parse = fn(input) {
  let parts = input |> split("\n\n")

  let (_s, seeds_str) = parts[0] |> Parse.tuple(": ")
  let seeds = Parse.list_of_numbers(seeds_str, " ")

  parts
  |> drop(1)
  |> map(fn(m) {
    m
    |> split("\n")
    |> drop(1)
    |> flat_map(fn (l) {
      let ls = Parse.list_of_numbers(l, " ")
      let dest = ls[0]
      let src = ls[1]
      let ln = ls[2]

      [
        (src, dest),
        (src + ln-1, dest + ln-1),
      ]
    })
    |> sort_by(fn (x) { x[0] })
  })
  |> inspect()

  inspect(parts)
}

let part1 = fn(parsed) {
  ""
}

let part2 = fn(parsed) {
  ""
}


// --------------

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
