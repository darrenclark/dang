import AocLib/Parse

let parse = fn(input) {
  let lines = Parse.lines(input)

  let (_1, times_str) = Parse.tuple(lines[0], ":")
  let (_2, dist_str) = Parse.tuple(lines[1], ":")

  {
    times: Parse.list_of_numbers(times_str, " "),
    dists: Parse.list_of_numbers(dist_str, " ")
  }
}

let part1 = fn(parsed) {
  var product = 1
  for i in range(0, len(parsed.times)) {
    let time = parsed.times[i]
    let dist = parsed.dists[i]
    product = product * count_winning(time, dist)
  }
  product
}

let part2 = fn(parsed) {
  let time =
    parsed.times
    |> map(str)
    |> join()
    |> int()

  let dist =
    parsed.dists
    |> map(str)
    |> join()
    |> int()

  count_winning(time, dist)
}

let count_winning = fn(time, dist) {
  var c = 0
  for hold in range(0, time) {
    if hold * (time - hold) > dist {
      c = c + 1
    }
  }
  c
}


// --------------

let input_path = first(argv)
if input_path == nil { raise("Expected path to input as first arg") }
let input = readfile(input_path)

let parsed = parse(input)

println("Part one: ", part1(parsed))
println("Part two: ", part2(parsed))
